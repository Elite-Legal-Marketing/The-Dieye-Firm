---
import { Font } from "astro:assets";
import Contact from "../components/Contact.astro";
import { resolveSeo, type SeoInput } from "../lib/seo";
import { getGlobalSeo } from "../sanity/globalSeo";
import Footer from "../components/Footer.astro";
import VideoModal from "../components/VideoModal.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  /* Absolute URL. Blog posts were the first genuinely shareable pages on the
     site, which is where these earned their keep. Still accepted, and still
     WINS over the derived canonical, so no page that was already correct can be
     changed by the SEO layer landing. */
  canonical?: string;
  ogType?: "website" | "article";
  ogImage?: string;
  /* /contact-us/ is the one page where the sitewide Contact section is the
     page rather than its closing prompt, so it renders a stripped-back
     variant. Forwarded rather than letting the page render its own Contact:
     one component, one form, one place the markup lives. See Contact.astro.

     "none" drops the section entirely, and /thank-you/ is the one page that
     asks for it: the visitor has just submitted this exact form, so closing
     with "Take the First Step - reach out for a free consultation" invites a
     duplicate enquiry and reads as though the first one didn't register. The
     comp omits it there too. Still a Layout prop rather than a page opting out
     by omission, so the default stays "every page closes with the prompt". */
  contactVariant?: "section" | "page" | "none";
  /* The page's Sanity `seo` block, if it has one. EVERY FIELD IS OPTIONAL and
     every one falls back to the props above, so passing nothing — or passing a
     document whose SEO tab was never opened — renders exactly what this page
     rendered before the tab existed. That is the acceptance test for the whole
     layer, not a nice property of it. */
  seo?: SeoInput | null;
}

const {
  title,
  description = "The Dieye Firm — compassionate, experienced family law representation.",
  canonical,
  ogType = "website",
  ogImage,
  contactVariant = "section",
  seo,
} = Astro.props;

/* One fetch for the whole build (memoised in PROD), and null is a normal
   result — the singleton need not exist for the site to build. */
const globalSeo = await getGlobalSeo();

const meta = resolveSeo(seo, {
  fallbackTitle: title,
  fallbackDescription: description,
  fallbackCanonical: canonical,
  pageUrl: Astro.url,
  defaultOgImage: globalSeo?.defaultOgImage,
});

/* Two ways to end up hidden: this page's own switch, or the sitewide one that
   exists to keep the staging address out of Google. robots.txt carries the
   same switch — this is the per-page half of it. */
const noIndex = meta.noIndex || globalSeo?.discourageCrawling === true;

/* A page hidden by its OWN switch gets no canonical and no og:url. Google
   ignores a canonical on a noindexed page anyway, and on /404 emitting one
   would invent "/404/" — a URL this site does not serve.

   Keyed on the page's own flag rather than on `noIndex` above, deliberately:
   the sitewide crawl switch is temporary staging state, and letting it strip
   the canonical off all 95 pages would make staging differ from production in
   a way nobody asked for. */
const selfReferential = !meta.noIndex;

const socialImage = meta.ogImage ?? ogImage;

/* Google Tag Manager container. Declared once and read by both snippets below —
   the script through `define:vars`, the noscript through normal interpolation —
   because two literal copies of an id like this drift the first time it
   changes and the failure is silent: tags simply stop firing. */
const GTM_ID = "GTM-TDHLNQ3G";

/* ═══ PRODUCTION ONLY ═══
 *
 * Every branch preview would otherwise report into the same container, so the
 * firm's analytics would carry our build-verification traffic as if it were
 * visitors.
 *
 * `VERCEL_ENV` and not `import.meta.env.PROD`: PROD is true for ANY
 * `astro build`, preview deploys included, so it cannot tell them apart.
 * Vercel sets VERCEL_ENV to "production" only on a production deployment,
 * "preview" on branch deploys, and leaves it unset locally — so a local build
 * and `astro dev` are both correctly GTM-free.
 *
 * `process.env`, not `import.meta.env`: Vite only exposes vars matching its
 * envPrefix (PUBLIC_ here), so `import.meta.env.VERCEL_ENV` is undefined. This
 * runs in Node at build time, where the real environment is available.
 *
 * To exercise tags on a preview, set VERCEL_ENV=production for that build — or
 * better, use a GTM environment so the container itself knows the difference. */
const gtmEnabled = process.env.VERCEL_ENV === "production";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    {/* Google Tag Manager. `define:vars` implies `is:inline`, which is the part
        that matters: without it Astro treats this as a module, bundles it, and
        defers it — which moves it out of the head and breaks the dataLayer
        timing GTM depends on. Google's snippet verbatim apart from the id,
        which comes from GTM_ID above. Placed as high in the head as the
        document allows, per Google's own instruction. */}
    {gtmEnabled && (
    <script is:inline define:vars={{ gtmId: GTM_ID }}>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer',gtmId);
    </script>
    )}
    {/* One icon, and it is the .ico deliberately. It carries 16/32/48 so the
        browser picks the right one, and there is no favicon.svg: the scaffold's
        was Astro's own rocket, declared FIRST, so every modern browser
        preferred it over the firm's — the site shipped with Astro's logo in the
        tab. Don't re-add an SVG without a vector of the bird to put in it. */}
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />

    <title>{meta.title}</title>
    {meta.description && <meta name="description" content={meta.description} />}
    {selfReferential && <link rel="canonical" href={meta.canonical} />}
    {/* "follow", not "nofollow": a hidden page's links still lead to pages that
        SHOULD be crawled, and that is the whole point on /404, where the nav is
        the visitor's and the crawler's way back. The sitewide switch's real
        barrier is robots.txt's Disallow, not this tag. */}
    {noIndex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={meta.title} />
    {meta.description && <meta property="og:description" content={meta.description} />}
    <meta property="og:site_name" content="The Dieye Firm" />
    {selfReferential && <meta property="og:url" content={meta.canonical} />}
    {socialImage && <meta property="og:image" content={socialImage} />}

    <meta name="twitter:card" content={socialImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={meta.title} />
    {meta.description && <meta name="twitter:description" content={meta.description} />}
    {socialImage && <meta name="twitter:image" content={socialImage} />}

    {/* Fonts: Source Serif 4 (headings) + Geist (body/UI), self-hosted and
        emitted by Astro. These are variable faces, so all weights come from
        three files (serif roman, serif italic, sans) and every one of them
        renders above the fold. Preloading all three is therefore the right
        trade — there are no unused weights to hold back. */}
    <Font cssVariable="--font-serif" preload />
    <Font cssVariable="--font-sans" preload />
    {/* Script face — one decorative word, below the fold. No preload: it
        should never contend with the two families above. */}
    <Font cssVariable="--font-script" />

    {/* Per-page head additions — JSON-LD, mostly. */}
    <slot name="head" />
  </head>
  <body>
    {/* Google Tag Manager's noscript fallback. Must be the FIRST thing in the
        body, per Google, and must stay a plain iframe — this one is not
        behind a click-to-load facade like the Wistia and map embeds, because
        it renders only for users without JavaScript and is display:none. */}
    {gtmEnabled && (
      <noscript
        set:html={`<iframe src="https://www.googletagmanager.com/ns.html?id=${GTM_ID}" height="0" width="0" style="display:none;visibility:hidden"></iframe>`}
      />
    )}

    <slot />
    {/* Site chrome — every page closes with the consultation prompt and the
        footer, so they live here rather than being remembered per page.
        /thank-you/ is the sole exception; see contactVariant above. */}
    {contactVariant !== "none" && <Contact variant={contactVariant} />}
    {/* For the rare section that has to sit below the consultation prompt
        rather than above it. /contact-us/ puts its office map here, because
        the comp runs hero → form → map and the default slot is above Contact,
        which would push the form under a 600px map. */}
    <slot name="after-contact" />
    <Footer />
    {/* Rendered at body level so `position: fixed` can never be broken by an
        ancestor transform/filter/contain, and so any page's video triggers
        have a modal to open without having to remember to include one. */}
    <VideoModal />

    {/* Enquiry-form behaviour, bound once for the whole document. Layout owns
        it because Layout is what guarantees a form is on the page at all
        (Contact, above) — and because a page may add more, as a blog post's
        sidebar does. The module binds each form separately. */}
    <script>
      import { initLeadForms } from "../scripts/lead-form";
      initLeadForms();
    </script>
  </body>
</html>
